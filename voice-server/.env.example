# ── Voice server ───────────────────────────────────────────────
# Port the Fastify/WebSocket server listens on.
PORT=8080

# Public base URL of the Next.js app (no trailing slash). The voice server
# POSTs the transcript here after a call ends.
APP_BASE_URL=https://hitchcode.com

# Shared secret. MUST match POST_CALL_SHARED_SECRET in the Next.js app.
# Sent as `x-internal-secret` when calling /api/ai-concierge/post-call-summary.
POST_CALL_SHARED_SECRET=

# ── Live call: OpenAI Realtime (speech-to-speech) ──────────────
OPENAI_API_KEY=
# Realtime (speech-to-speech) model that runs the live call.
OPENAI_REALTIME_MODEL=gpt-realtime
# Realtime voice: marin | cedar | alloy | ash | ballad | verse | ...
OPENAI_REALTIME_VOICE=marin
# Transcription model for caller speech (builds the transcript).
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Turn detection — biggest lever on how the call feels.
# server_vad (default): confident interruption via a loudness threshold so the
# AI keeps talking through background noise. semantic_vad: ends turns by meaning.
REALTIME_TURN_DETECTION=server_vad
# server_vad: 0-1. Higher = needs louder/clearer speech to interrupt the AI
# (less likely to stutter on a stray noise). Default 0.5; we use 0.6.
REALTIME_VAD_THRESHOLD=0.6
# server_vad: audio padding included before detected speech start (ms).
REALTIME_PREFIX_PADDING_MS=300
# server_vad: trailing silence (ms) before the caller's turn is considered done.
REALTIME_SILENCE_MS=700
# semantic_vad only: eagerness low | medium | high | auto
REALTIME_EAGERNESS=low

# ── Optional: cascade / post-call recap voicemail (NOT the live loop) ──
OPENAI_LIVE_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
DEEPGRAM_API_KEY=
