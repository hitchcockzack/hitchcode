# ─────────────────────────────────────────────────────────────
# Hitchcode — Next.js app environment (Vercel)
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=
# Full wss endpoint of the voice server (include /twilio-media), e.g.
# wss://voice.hitchcode.net/twilio-media
VOICE_SERVER_WS_URL=
# Public https URL of the voice server (for reference / health checks)
VOICE_SERVER_HTTP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional. If unset, the app uses {NEXT_PUBLIC_SITE_URL}/api/twilio/status
TWILIO_STATUS_CALLBACK_URL=
# Optional. Set to "true" to verify X-Twilio-Signature on status callbacks.
TWILIO_VALIDATE_SIGNATURE=

# AI
OPENAI_API_KEY=
# Post-call summary model (used by the Next.js app).
OPENAI_SUMMARY_MODEL=gpt-4.1
# Live-call realtime model/voice are consumed by the VOICE SERVER, not the app.
# See voice-server/.env.example: OPENAI_REALTIME_MODEL, OPENAI_REALTIME_VOICE, etc.
OPENAI_LIVE_MODEL=gpt-4.1-mini

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Email
RESEND_API_KEY=
INTERNAL_LEAD_EMAIL=
FROM_EMAIL=

# ─────────────────────────────────────────────────────────────
# Added beyond the base list (security / ops). See README/deliverables.
# ─────────────────────────────────────────────────────────────
# Shared secret protecting POST /api/ai-concierge/post-call-summary.
# MUST match POST_CALL_SHARED_SECRET in the voice server.
POST_CALL_SHARED_SECRET=
# Simple token gate for /admin/ai-concierge (?key=...). TODO: replace with real auth.
ADMIN_DASHBOARD_TOKEN=
# Locks GET /api/ai-concierge/health (daily Vercel cron) — Vercel sends it as a
# Bearer token. Generate with `openssl rand -hex 32`. Unset = endpoint is public.
CRON_SECRET=
# Pushover — operator alerts: concierge call started/ended/failed and health-check
# failures (also used by /api/notify).
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Note: OPENAI_LIVE_MODEL and the ELEVENLABS_* vars above are consumed by the
# voice server (voice-server/.env), not the Next.js app. They are listed here so
# all required keys live in one place.
